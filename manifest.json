{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "生成二维码"
   },
   "background": {
      "service_worker": "background.js"
   },
   "description": "一键把当前网页链接或任意文本生成二维码（类似草料）：下载 PNG、复制图片/链接、右键菜单生成，可调颜色与尺寸。",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Link2QR · 链接转二维码",
   "permissions": [ "activeTab", "contextMenus", "storage", "clipboardWrite" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.3"
}
